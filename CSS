body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f5f5f5;
}

header{
    background:#111;
    color:white;
    padding:15px;
    text-align:center;
}

nav a{
    color:white;
    margin:10px;
    text-decoration:none;
}

.hero{
    background:#007bff;
    color:white;
    text-align:center;
    padding:40px;
}

.card{
    width:250px;
    margin:20px auto;
    padding:15px;
    background:white;
    border-radius:8px;
    text-align:center;
    box-shadow:0 0 8px #ccc;
}

.card img{
    width:100%;
}

button{
    background:#007bff;
    color:white;
    border:none;
    padding:10px 20px;
    border-radius:5px;
    cursor:pointer;
}

footer{
    background:#111;
    color:white;
    text-align:center;
    padding:15px;
}
